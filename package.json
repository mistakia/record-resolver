{
  "name": "record-resolver",
  "version": "1.0.0-alpha.0",
  "description": "Resolve audio URLs to Record Protocol v1 ResolverEntry records via yt-dlp",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "record-resolver": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:network": "RECORD_RESOLVER_NETWORK=1 bun test test/network",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "check:dist": "sh cli/check-dist.sh",
    "verify": "bun run lint && bun run typecheck && bun run check:dist"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "typescript": "6.0.3"
  },
  "trustedDependencies": []
}
